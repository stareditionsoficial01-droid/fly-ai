{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fly-ai",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
